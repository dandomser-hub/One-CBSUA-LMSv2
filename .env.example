# Public client configuration only. Never use a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Prototype shortcuts for synthetic seeded accounts. Set false for a live deployment.
VITE_ENABLE_DEMO_LOGIN=true

# Public synthetic demo password, exposed in the UI. Never use a real account password.
# Match VLP_DEMO_PASSWORD when seeding or repairing test accounts.
VITE_DEMO_PASSWORD=Password123!
